# ============================================================
#  barbet-4.19-stage1-plain.env
#  阶段 1：纯内核（不带任何 root 方案）
#
#  目的：只验证一件事 —— 编出来的内核能不能在这台机器上正常启动
#
#  为什么需要这个阶段：
#    vendor_boot 里有 218 个 stock 内核模块，它们会校验内核的
#    release 串（vermagic）与 CONFIG_MODVERSIONS 的 CRC。
#    如果 release 串对不上，开机时 vendor 模块加载失败，
#    可能表现为黑屏 / WiFi 不能用 / 相机失效 等。
#
#    而 KernelSU 与 SUSFS **不影响** vermagic。
#    所以先用不带 root 的版本把「启动 + 模块兼容」这件事验证掉，
#    失败原因就是唯一的（release 串），不与 KSU/SUSFS 的问题混淆。
#
#  验证方式：fastboot boot（不写分区，失败重启即恢复）
#  通过后再用 barbet-4.19-susfs.env 编正式版。
# ============================================================

CONFIG_ENV=config/barbet-4.19-stage1-plain.env

# ---------------- 内核源码 ----------------
KERNEL_SOURCE=https://github.com/LineageOS/android_kernel_google_redbull
KERNEL_SOURCE_BRANCH=lineage-20
KERNEL_CONFIG=redbull_defconfig
KERNEL_IMAGE_NAME=Image.lz4
ARCH=arm64

# ⚠️ 本阶段最关键的一行。
# 设备当前 stock release 串：4.19.269-g8728c337137c-ab10161573
# 树自带 LOCALVERSION 会生成 4.19.269-g<别的hash>，对不上就会触发模块加载失败。
# 所以这里【主动对齐 stock 后缀】。
KERNEL_NAME=g8728c337137c-ab10161573

ADD_LOCALVERSION_TO_FILENAME=false

# ---------------- 工具链 ----------------
CLANG_BRANCH=master-kernel-build-2022
CLANG_VERSION=r450784e
USE_LLVM=false
ENABLE_GCC_ARM64=true
ENABLE_GCC_ARM32=true

EXTRA_CMDS:LD=ld.lld KCFLAGS=-Wno-error=strict-prototypes
CUSTOM_CMDS:CLANG_TRIPLE=aarch64-linux-gnu-

# ---------------- 不带 root 方案 ----------------
# none = 不集成任何 root，纯粹编一棵能跑的内核
KSU_VARIANT=none
KSU_REF=
KSU_HOOK_MODE=auto
ENABLE_KPM=false
ENABLE_SUSFS=false
ENABLE_PATH_UMOUNT=false
ENABLE_HIDE_STUFF=false

# ---------------- Kconfig ----------------
ADD_OVERLAYFS_CONFIG=false
ADD_KPROBES_CONFIG=false
DISABLE_LTO=false
DISABLE_CC_WERROR=true
EXTRA_DEFCONFIG=

# ---------------- 打包 ----------------
USE_CUSTOM_ANYKERNEL3=false
NEED_DTBO=false
BUILD_BOOT_IMG=false
SOURCE_BOOT_IMAGE=

# ---------------- Runner ----------------
ENABLE_CCACHE=true
REMOVE_UNUSED_PACKAGES=true
